NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ktux
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters-please-use-a-random-value-01
JWT_REFRESH_SECRET=replace-with-a-different-at-least-64-random-characters-please-use-a-random-value-02
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=false
BODY_LIMIT=100kb
LOG_LEVEL=info
SENTRY_DSN=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

EMAIL_FROM=Ktux <noreply@example.com>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ktux

GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads
ZAPIER_WEBHOOK_SECRET=

SLACK_WEBHOOK_URL=

GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_MAX_MESSAGE_LENGTH=4000
AI_SESSION_RETENTION_DAYS=30
AI_AUDIT_RETENTION_DAYS=7
AI_FETCH_TIMEOUT_MS=8000
