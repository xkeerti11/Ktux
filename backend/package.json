    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "26.1.2",
    "@types/pdfkit": "0.17.6",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "8.6.2",
    "googleapis": "174.0.0",
    "helmet": "8.3.0",
